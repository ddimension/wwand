# /etc/config/apntest — wwand-apntest plan. Empty by default: nothing runs
# until a test is configured. Validate with `wwand-apntest check`.
#
# config apntest 'globals'
#	option modem       'wwmodem0'          # the wwand_modem section to test on
#	# option interface 'wan'               # default: its only proto wwand interface
#	option schedule    '*/10 * * * *'      # cron syntax; written by the init script
#	option run_budget  '900'               # seconds for a whole sweep
#	option restore_sim '1'                 # back to the starting slot afterwards
#	option monitor     'monitor.example.net'   # NSCA receiver
#	option nsca_host   'apntester-1'           # host name in the monitor
#	option nsca_cfg    '/etc/send_nsca.cfg'    # send_nsca password file
#
# config apntest_sim 'card1'
#	option slot '1'                        # physical slot (eUICC profiles: later phase)
#
# config apntest 'example'
#	option sim          'card1'
#	option apn          'internet.example'
#	# option auth 'both'  option username '…'  option password '…'
#	option pdp_type     'ipv4'
#	option ip_regex     '^10\.'            # the pool addresses must come from
#	option dns_regex    '^10\.'
#	option detach_after '1'                # IMSI detach/re-attach after the test
#	option service      'apn-example'      # the monitor service of the first check
#	# option nsca_port  '5667'
#	list   check        'ping:8.8.8.8'     # first check = the test itself
