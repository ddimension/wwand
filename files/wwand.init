#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026 André Valentin <avalentin@marcant.net>
# wwand — QMI connection manager daemon

START=25
STOP=85

USE_PROCD=1

# Precompiled ucode bytecode carries a format version (UCODE_BYTECODE_VERSION),
# and an interpreter upgraded past it REFUSES to load the tree. That refusal is
# clean — but the daemon then exits immediately and procd respawns it forever
# with nothing in the log that says why. Probe once and say it plainly instead.
#
# Only the two bytecode-specific failures block the start; anything else falls
# through, so an unrelated import error never keeps the daemon from running.
wwand_modules_loadable() {
	local err

	err=$(ucode -e 'import * as l from "wwand.log";' 2>&1) && return 0

	case "$err" in
	*"Bytecode version mismatch"*|*"Invalid file magic"*)
		logger -t wwand -p daemon.err "cannot load the installed ucode modules: $err"
		logger -t wwand -p daemon.err \
			"this build ships PRECOMPILED bytecode that the running ucode cannot read — reinstall wwand built against this ucode, or use a build with CONFIG_WWAND_UCODE_SOURCE"
		return 1
		;;
	esac

	return 0
}

start_service() {
	# refuse rather than respawn-loop on an unreadable ucode tree
	wwand_modules_loadable || return 1

	procd_open_instance
	procd_set_param command /usr/sbin/wwand
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# also watch /etc/config/network: the compat layer derives modems and
	# contexts from the proto-qmi interface sections, so edits there must
	# reach the daemon the same way wwand config edits do
	procd_add_reload_trigger "wwand" "network"
}

reload_service() {
	# daemon dead/hung -> the edit would silently never apply; restart instead
	ubus -t 10 call wwand reload || restart
}
